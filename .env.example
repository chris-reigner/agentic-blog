# Secrets only. All other tunables live in config/*.yaml.
# Local Ollama (the default in config/llm.yaml) needs no key — leave this unset.
# Set it only for remote backends (OpenRouter, OpenAI, Anthropic OpenAI-compat).
# LLM_API_KEY=sk-or-your-openrouter-key

# Optional per-deploy overrides (otherwise config/*.yaml wins):
# AGENTIC_BLOG_CONFIG=config
